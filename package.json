{
  "name": "hunch",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d --wait",
    "docs:links": "bun scripts/check-links.ts",
    "secrets:history": "bun scripts/scan-history.ts"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "source-map-js": ">=1.2.2",
    "follow-redirects": ">=1.16.2",
    "vite": ">=8.3.5",
    "hono": ">=4.13.13",
    "vitest": "^4.1.12",
    "@vitest/mocker": "^4.1.12"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
