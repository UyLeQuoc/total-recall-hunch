# Hunch's environment. Copy to .env and fill it in. Never commit .env: CI fails if one is tracked.

# ── Tatum: every Sui call (ADR-0003). One key per network, from dashboard.tatum.io.
TATUM_API_KEY=
TATUM_API_KEY_TESTNET=
TATUM_SUI_GRPC=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_GRPC_TESTNET=https://sui-testnet-grpc.gateway.tatum.io
# Where Sui calls go while Tatum answers 402 (ADR-0004). Blank: the public fullnode. "off": none.
SUI_GRPC_FALLBACK=
SUI_GRPC_FALLBACK_TESTNET=

# ── Walrus Memory on mainnet (ADR-0005): the submitter's account, from memory.walrus.xyz.
MEMWAL_ACCOUNT_ID=
# The delegate key, 64 hex.
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# From the relayer's GET /config, not the docs: a second mainnet deployment supersedes the docs' ids.
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f
MEMWAL_NETWORK=mainnet

# ── Sui testnet: the anchors (hunch::anchor) and DeepBook Predict (P1).
# suiprivkey1…, pays the anchors' gas.
SUI_SPONSOR_KEY=
# Set after `sui client publish` of packages/move/hunch.
HUNCH_PACKAGE_ID=

# ── Postgres (`bun run db:up`, port 5437).
DATABASE_URL=postgres://hunch:hunch@localhost:5437/hunch

# ── The model that compiles hunches (PRD §12: one provider API).
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
